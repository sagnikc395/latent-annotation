# Copy to .env and fill in. .env is gitignored; .env.example is not.

# mock         -> offline scripted client, no token needed (default when HF_TOKEN is unset)
# huggingface  -> Qwen-3 via the HuggingFace Inference API
LLM_PROVIDER=mock

# HuggingFace access token (https://huggingface.co/settings/tokens)
# HUGGINGFACE_API_KEY is accepted as an alias.
HF_TOKEN=

# Any tool-calling model served on HF. Smaller Qwen-3 variants work for smoke
# tests; the large instruct model is the one to evaluate against.
LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
